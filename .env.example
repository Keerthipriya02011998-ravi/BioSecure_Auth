# Copy to .env.local
SESSION_SECRET=change-me-to-a-long-random-string
# Show the 6-digit code on screen (demo mode, because no SMS/email provider is connected).
# Set to "false" once a real sender is wired into lib/sender.js
DEMO_SHOW_CODE=true
# Optional overrides for passkeys. By default they are derived from the request host.
# RP_ID=localhost
# ORIGIN=http://localhost:3000
